{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GameNWatchDS: compilar ROM limpia",
      "type": "process",
      "command": "C:\\msys64\\usr\\bin\\make.exe",
      "args": ["rebuild"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "GameNWatchDS: diagnóstico del núcleo",
      "type": "process",
      "command": "py",
      "args": ["-3", "tools/run_core_tests.py", "--game", "all"],
      "dependsOn": "GameNWatchDS: compilar ROM limpia",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "GameNWatchDS: aceptación melonDS DS",
      "type": "process",
      "command": "py",
      "args": ["-3", "tools/run_headless_tests.py", "--game", "all", "--no-screenshots"],
      "dependsOn": "GameNWatchDS: compilar ROM limpia",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
