{
    "git.path": "C:\\Program Files\\Git\\cmd\\git.exe",

    // ----- clangd (replaces the IntelliSense of the Microsoft C/C++ extension) -----
    // clangd uses the binary downloaded by the "clangd" extension
    // (llvm-vs-code-extensions.vscode-clangd); no clangd.path needed.
    "clangd.arguments": [
        // Let clangd run the cross compiler arm-none-eabi-gcc
        // to obtain the system include paths (picolibc/newlib).
        "--query-driver=C:/msys64/opt/wonderful/toolchain/gcc-arm-none-eabi/bin/*",
        "--background-index",
        "--header-insertion=iwyu"
    ],
    "clangd.fallbackFlags": [
        "-D__NDS__",
        "-D__BLOCKSDS__",
        "-DARM9",
        "-Iarm9/source",
        "-Iarm9/source/games",
        "-Iarm9/source/gw_sys",
        "-Iarm9/source/cpus",
        "-IC:/msys64/opt/blocksds/core/libs/libnds/include"
    ],

    // ----- Disable the IntelliSense of the C/C++ (MS) extension -----
    // clangd now handles analysis, autocompletion and diagnostics.
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.formatting": "disabled"
}
